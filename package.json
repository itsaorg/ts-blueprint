{
  "name": "@itsaorg/ts-blueprint",
  "description": "TypeScript library blueprint / GitHub template for Itsa repos",
  "version": "0.0.0",
  "main": "dist/index.js",
  "scripts": {
    "husky:prepare": "node .devenv/deps/husky/prepare.mjs",
    "prepare": "npm run husky:prepare",
    "tsc:typecheck": "node .devenv/deps/tsc/typecheck.mjs",
    "tsc:emit": "node .devenv/deps/tsc/emit.mjs",
    "tsc:build": "node .devenv/deps/tsc/build.mjs",
    "prettier:write": "node .devenv/deps/prettier/write.mjs",
    "prettier:check": "node .devenv/deps/prettier/check.mjs",
    "eslint:lint": "node .devenv/deps/eslint/lint.mjs",
    "eslint:fix": "node .devenv/deps/eslint/fix.mjs",
    "layout:check": "node .devenv/deps/layout/check.mjs",
    "vitest": "node .devenv/deps/vitest/watch.mjs",
    "vitest:run": "node .devenv/deps/vitest/run.mjs",
    "vitest:coverage": "node .devenv/deps/vitest/coverage.mjs",
    "vitest:verbose": "node .devenv/deps/vitest/verbose.mjs",
    "check": "node .devenv/deps/check/run.mjs",
    "commitlint": "node .devenv/deps/commitlint/lint.mjs",
    "lint-staged": "node .devenv/deps/lint-staged/run.mjs",
    "dist:clean": "node .devenv/utils/clean.mjs --path dist --recursive",
    "coverage:clean": "node .devenv/utils/clean.mjs --path coverage --recursive",
    "docs:clean": "node .devenv/utils/clean.mjs --path docs --recursive",
    "modules:clean": "node .devenv/utils/clean.mjs --path node_modules --recursive",
    "typedoc": "node .devenv/deps/typedoc/build.mjs",
    "changeset:status": "node .devenv/deps/changeset/status.mjs",
    "changeset:version": "node .devenv/deps/changeset/version.mjs",
    "npm:publish:local": "node .devenv/tools/npm/publish-local.mjs",
    "npm:publish:worker": "node .devenv/tools/npm/publish-worker.mjs",
    "npm:trust": "node .devenv/tools/npm/trust.mjs",
    "npm:deprecate:reservation": "node .devenv/tools/npm/deprecate-reservation.mjs",
    "npm:release": "node .devenv/tools/npm/release.mjs",
    "setup": "node .devenv/setup/setup.mjs",
    "setup:post-clone": "node .devenv/setup/post-clone.mjs",
    "setup:labels": "node .devenv/setup/github-labels.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsaorg/ts-blueprint.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": "https://github.com/itsaorg/ts-blueprint/issues",
  "homepage": "https://itsaorg.github.io/ts-blueprint/",
  "license": "Apache-2.0",
  "engines": {
    "node": "26"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json,md,yml,yaml}": "prettier --config configs/.prettierrc.json --ignore-path configs/prettierignore --write",
    "*.ts": "eslint --config configs/eslint.config.js --fix"
  },
  "files": [
    "dist/",
    "NOTICE",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts"
}
